includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    # The package ships its own config file; tell larastan this is a config
    # directory so `env()` calls in it are not flagged as app-code usage.
    configDirectories:
        - config
