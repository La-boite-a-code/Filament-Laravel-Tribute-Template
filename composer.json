{
    "name": "laboiteacode/laravel-design",
    "description": "A premium Filament v5 theme.",
    "keywords": [
        "laboiteacode",
        "laravel",
        "laravel-design",
        "filament",
        "filament-theme",
        "filament-plugin"
    ],
    "homepage": "https://github.com/laboiteacode/laravel-design",
    "support": {
        "issues": "https://github.com/laboiteacode/laravel-design/issues",
        "source": "https://github.com/laboiteacode/laravel-design"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "La Boite à Code",
            "email": "alexandre@laboiteacode.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Laboiteacode\\LaravelDesign\\": "src/",
            "Laboiteacode\\LaravelDesign\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laboiteacode\\LaravelDesign\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laboiteacode\\LaravelDesign\\LaravelDesignServiceProvider"
            ],
            "aliases": {
                "LaravelDesign": "Laboiteacode\\LaravelDesign\\Facades\\LaravelDesign"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
