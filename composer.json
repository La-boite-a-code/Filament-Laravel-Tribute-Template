{
    "name": "laboiteacode/filament-laravel-tribute-template",
    "description": "A free Filament v5 theme paying tribute to the laravel.com art direction. First of a series of homage themes.",
    "keywords": [
        "laboiteacode",
        "laravel",
        "filament",
        "filament-theme",
        "filament-plugin",
        "tribute-theme"
    ],
    "homepage": "https://github.com/laboiteacode/filament-laravel-tribute-template",
    "support": {
        "issues": "https://github.com/laboiteacode/filament-laravel-tribute-template/issues",
        "source": "https://github.com/laboiteacode/filament-laravel-tribute-template"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "La Boite à Code",
            "email": "alexandre@laboiteacode.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LaBoiteACode\\LaravelTributeTemplate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaBoiteACode\\LaravelTributeTemplate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaBoiteACode\\LaravelTributeTemplate\\LaravelTributeTemplateServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
